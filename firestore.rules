rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authenticated check
    function isAuthenticated() {
      return request.auth != null;
    }


    // Administrative accounts collection
    match /admins/{userId=**} {
      allow read, write: if isAuthenticated();
    }

    // Public CMS Data Collections:
    // Public visitors: Read-only access
    // Authenticated staff: Write access
    match /siteSettings/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /homepage/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /departments/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /facilities/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /about/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /academics/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /placements/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /achievements/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /announcements/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /events/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Prospective Student Admission Enquiries:
    // Public visitors can submit (create); only authenticated staff can read, update status, or delete.
    match /enquiries/{enquiryId=**} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }
  }
}
